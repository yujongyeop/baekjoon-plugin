{
  "manifest_version": 3,
  "name": "백준 예제 따옴표 변환기",
  "version": "1.1.0",
  "description": "백준 예제 입력/출력을 각 라인별로 따옴표를 붙여서 변환합니다.",
  "permissions": ["activeTab", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.acmicpc.net/problem/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
